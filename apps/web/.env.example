# BiyaHey! web app environment
#
# Copy to `.env.local` (git-ignored) and adjust. Vite inlines these at build
# time, so they must be prefixed with VITE_ to reach the browser.

# Base URL of the Plan 1 BFF. Defaults to the local compose stack when unset.
VITE_API_URL=http://localhost:8787

# Optional issue-tracker URL used by the L3 licence sheet's "report an issue"
# link. Leave empty to show the honest "reporting is not wired yet" message
# (there is no tracker configured in this repo; POST /reports is phase 4).
VITE_REPORT_ISSUE_URL=
