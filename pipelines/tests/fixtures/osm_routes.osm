  <node id="1008" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.6025000" lon="121.0025000"/>
  <node id="1009" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.6075000" lon="121.0075000"/>
  <node id="1010" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5700000" lon="121.0100000"/>

  <way id="2001" version="1" timestamp="2026-10-31T21:23:00Z">
    <nd ref="1001"/>
    <nd ref="1008"/>
    <nd ref="1002"/>
    <tag k="railway" v="subway"/>
    <tag k="name" v="MRT-3 track southbound"/>
  </way>
  <way id="2002" version="1" timestamp="2026-10-31T21:23:00Z">
    <nd ref="1002"/>
