    <tag k="type" v="route"/>
    <tag k="route" v="road"/>
    <tag k="ref" v="R1"/>
    <tag k="name" v="Not a transit route"/>
  </relation>
  <relation id="3005" version="1" timestamp="2026-10-31T21:23:00Z">
    <!-- DANGLING: way 8998 is not in this extract, so this route has no geometry -->
    <member type="way" ref="8998" role=""/>
    <tag k="type" v="route"/>
    <tag k="route" v="bus"/>
    <tag k="ref" v="B2"/>
    <tag k="name" v="Unresolved bus route"/>
