  <node id="8007" version="1" timestamp="2026-11-04T00:00:00Z" lat="14.6680000" lon="121.0100000">
    <tag k="name" v="Off Chain Stop"/>
    <tag k="public_transport" v="stop_position"/>
  </node>
  <node id="8008" version="1" timestamp="2026-11-04T00:00:00Z" lat="14.7000000" lon="121.0000000"/>
