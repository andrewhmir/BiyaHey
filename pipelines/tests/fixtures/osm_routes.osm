    <member type="node" ref="9999" role="stop"/>
    <tag k="type" v="route"/>
    <tag k="route" v="light_rail"/>
    <tag k="ref" v="MRT-3"/>
    <tag k="name" v="MRT Line 3"/>
    <tag k="from" v="North Avenue"/>
    <tag k="to" v="GMA Kamuning"/>
