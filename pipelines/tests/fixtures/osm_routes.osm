    <tag k="name" v="Pasig River"/>
  </way>
  <way id="2102" version="1" timestamp="2026-10-31T21:23:00Z">
    <nd ref="1004"/>
    <nd ref="1010"/>
    <nd ref="1005"/>
    <tag k="highway" v="primary"/>
    <tag k="name" v="EDSA"/>
  </way>

  <relation id="3001" version="1" timestamp="2026-10-31T21:23:00Z">
    <member type="way" ref="2001" role=""/>
    <!-- DANGLING: way 8999 is not in this extract (Task 5 bbox clip limitation) -->
    <member type="way" ref="8999" role=""/>
    <member type="way" ref="2002" role=""/>
    <member type="node" ref="1001" role="stop"/>
    <member type="node" ref="1002" role="stop"/>
    <member type="node" ref="1003" role="stop"/>
