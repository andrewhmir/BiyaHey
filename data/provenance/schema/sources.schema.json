{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiyaHey! data provenance registry",
  "description": "Shape of data/provenance/sources.yaml (spec §8.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "publisher",
        "url",
        "licence_spdx",
        "licence_url",
        "coverage",
        "last_checked",
        "attribution",
        "used_for"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "osm",
            "osm-wiki-jeepney",
            "ltfrb-fares",
            "rail-fares",
            "mmda-ferry",
            "psgc",
            "photon",
            "openfreemap",
            "motis",
            "crowd-reports"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "licence_spdx": {
          "type": "string",
          "enum": ["ODbL-1.0", "CC-BY-SA-2.0", "MIT", "CC0-1.0", "NOASSERTION"]
        },
        "licence_url": { "type": "string", "pattern": "^https?://" },
        "coverage": { "type": "string", "minLength": 1 },
        "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "attribution": { "type": "string", "minLength": 1 },
        "used_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
