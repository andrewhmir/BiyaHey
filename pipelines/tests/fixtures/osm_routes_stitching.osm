<?xml version='1.0' encoding='UTF-8'?>
<!--
  Hand-written miniature OSM extract used by pipelines/tests/test_osm_routes_geometry.py.

  It reproduces the bad route-relation geometry shapes seen in the real NCR
  extract that made the route map draw straight lines through buildings:

  * 4001 bus-stitch1  way members are out of relation order and one is stored in
                      the opposite direction (4103 is F->E, travel is E->F);
                      endpoint stitching must rebuild A-B-C-D-E-F in travel order.
  * 4002 bus-stitch2  two detached fragments (4113, 4114) that share no endpoint
                      with the main chain; they must be dropped and counted, never
                      concatenated into a beeline.
  * 4003 bus-stitch3  the only way member has two points but the relation carries
                      three ordered stop nodes; the shape falls back to the ordered
                      stop coordinates instead of a bare two-point line.
  * 4004 bus-stitch4  two points and two stops: no better geometry exists, so the
                      bare two-point shape is kept.
  * 4005 bus-stitch5  two points, three stops, but the stop order zigzags far
                      beyond the two-point span; the fallback must not make the
                      geometry worse.
  * 4006 bus-stitch6  a single way stored B->A while the stops are ordered A then B;
                      the resolved shape is oriented to start at the first stop.

  Everything is offline and committed: no test downloads or queries OSM.
-->
<osm version="0.6" generator="biyahey-test-fixture">
  <!-- relation 4001: out-of-order / reversed members, chain A..F -->
  <node id="1101" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5000000" lon="121.0000000">
    <tag k="name" v="Stitch Start"/>
    <tag k="public_transport" v="stop_position"/>
  </node>
  <node id="1102" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5050000" lon="121.0050000"/>
  <node id="1103" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5100000" lon="121.0100000"/>
  <node id="1104" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5150000" lon="121.0150000"/>
  <node id="1105" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5200000" lon="121.0200000"/>
  <node id="1106" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.5250000" lon="121.0250000">
    <tag k="name" v="Stitch End"/>
    <tag k="public_transport" v="stop_position"/>
  </node>

  <way id="4101" version="1" timestamp="2026-10-31T21:23:00Z">
    <nd ref="1101"/>
    <nd ref="1102"/>
    <nd ref="1103"/>
  </way>
  <way id="4102" version="1" timestamp="2026-10-31T21:23:00Z">
    <nd ref="1103"/>
    <nd ref="1104"/>
    <nd ref="1105"/>
  </way>
  <way id="4103" version="1" timestamp="2026-10-31T21:23:00Z">
    <nd ref="1106"/>
    <nd ref="1105"/>
  </way>

  <relation id="4001" version="1" timestamp="2026-10-31T21:23:00Z">
    <member type="way" ref="4102" role=""/>
    <member type="way" ref="4101" role=""/>
    <member type="way" ref="4103" role=""/>
    <member type="node" ref="1101" role="stop"/>
    <member type="node" ref="1106" role="stop"/>
    <tag k="type" v="route"/>
    <tag k="route" v="bus"/>
    <tag k="ref" v="STITCH-1"/>
    <tag k="name" v="Shuffled members"/>
  </relation>

  <!-- relation 4002: main chain A-B-C plus two detached fragments -->
  <node id="1111" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.6000000" lon="121.0000000">
    <tag k="name" v="Main Start"/>
    <tag k="public_transport" v="stop_position"/>
  </node>
  <node id="1112" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.6050000" lon="121.0050000"/>
