{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiyaHey! data provenance registry",
  "description": "Shape of data/provenance/sources.yaml (spec §8.1). Rows are either external datasets/services (the default, `kind: dataset`) or values BiyaHey! computes itself (`kind: derived`). The derived branch was added additively in Task 5 (PH-wide coverage) for the `walk-estimate` row: a computed estimate has no dataset URL and must not invent one, so it omits `licence_url` and must use SPDX's explicit `NOASSERTION` marker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "publisher",
        "coverage",
        "last_checked",
        "attribution",
        "used_for"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "osm",
            "osm-wiki-jeepney",
            "ltfrb-fares",
            "rail-fares",
            "mmda-ferry",
            "psgc",
            "photon",
            "openfreemap",
            "motis",
            "crowd-reports",
            "walk-estimate"
          ]
        },
        "kind": {
          "type": "string",
          "enum": ["dataset", "derived"],
          "default": "dataset",
          "description": "dataset (default): an external dataset or service with a `url`, `licence_spdx` and `licence_url`. derived: computed by BiyaHey! from its own method; it must not claim a dataset licence."
        },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "licence_spdx": {
          "type": "string",
          "enum": ["ODbL-1.0", "CC-BY-SA-2.0", "MIT", "CC0-1.0", "NOASSERTION"]
        },
        "licence_url": { "type": "string", "pattern": "^https?://" },
        "coverage": { "type": "string", "minLength": 1 },
        "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "attribution": { "type": "string", "minLength": 1 },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "For kind=derived: how the value is computed, in words. Required so a derived row cannot hide its method."
        },
        "used_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "derived" } }
          },
          "then": {
            "required": ["kind", "method", "licence_spdx"],
            "properties": { "licence_spdx": { "const": "NOASSERTION" } },
            "not": { "required": ["licence_url"] }
          },
          "else": {
            "required": ["url", "licence_spdx", "licence_url"]
          }
        }
      ]
    }
  }
}
