{
  "name": "biyahey",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Philippine commuter route-planner PWA",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "ci": "npm run lint && npm run typecheck && npm test",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
