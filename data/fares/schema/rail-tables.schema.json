{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiyaHey! rail fare tables",
  "description": "Shape of data/fares/rail-tables.yaml (spec §8.3, ruling R4). LRT-1 is a formula; MRT-3/LRT-2 are discounted distance bands.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_url", "currency", "lines"],
  "properties": {
    "source_id": { "const": "rail-fares" },
    "source_url": { "type": "string", "pattern": "^https?://" },
    "currency": { "const": "PHP" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/line" }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "operator", "fare_model", "effective_from", "confidence"],
      "properties": {
        "id": { "enum": ["lrt1", "lrt2", "mrt3"] },
        "name": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "fare_model": { "enum": ["formula", "band"] },
        "boarding": { "type": "number", "minimum": 0 },
        "per_km": { "type": "number", "exclusiveMinimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "length_km": { "type": "number", "exclusiveMinimum": 0 },
        "discount": { "type": "number", "minimum": 0, "maximum": 1 },
        "effective_from": { "$ref": "#/definitions/date" },
        "confidence": { "enum": ["official", "estimated"] },
        "needs_verification": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "fare_model": { "const": "formula" } }, "required": ["fare_model"] },
          "then": { "required": ["boarding", "per_km"] }
        },
        {
          "if": { "properties": { "fare_model": { "const": "band" } }, "required": ["fare_model"] },
          "then": { "required": ["min", "max", "length_km", "discount"] }
        },
        {
          "if": { "properties": { "id": { "const": "lrt2" } }, "required": ["id"] },
          "then": {
            "required": ["needs_verification"],
            "properties": { "needs_verification": { "const": true } }
          }
        }
      ]
    }
  }
}
