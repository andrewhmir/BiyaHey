  <relation id="4003" version="1" timestamp="2026-10-31T21:23:00Z">
    <member type="way" ref="4121" role=""/>
    <member type="node" ref="1131" role="stop"/>
    <member type="node" ref="1133" role="stop"/>
    <member type="node" ref="1132" role="stop"/>
