    <tag k="name" v="North Avenue"/>
    <tag k="public_transport" v="stop_position"/>
  </node>
  <node id="1002" version="1" timestamp="2026-10-31T21:23:00Z" lat="14.6050000" lon="121.0050000">
    <tag k="name" v="Quezon Avenue"/>
    <tag k="public_transport" v="stop_position"/>
  </node>
